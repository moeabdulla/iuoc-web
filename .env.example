# `bun run dev` / Convex setup writes these two values for your deployment.
# Leave these examples commented until setup; do not point at production.
# CONVEX_DEPLOYMENT=dev:your-development-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configure YOUTUBE_API_KEY, YOUTUBE_CHANNEL_ID and
# YOUTUBE_UPLOADS_PLAYLIST_ID in your Convex deployment's environment settings.
# Never prefix the API key with NEXT_PUBLIC_ or put production deploy keys here.
