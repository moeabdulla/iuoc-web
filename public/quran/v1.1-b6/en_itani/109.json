{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"Say, “O disbelievers.","footnotes":null},{"aya":2,"text":"I do not worship what you worship.","footnotes":null},{"aya":3,"text":"Nor do you worship what I worship.","footnotes":null},{"aya":4,"text":"Nor do I serve what you serve.","footnotes":null},{"aya":5,"text":"Nor do you serve what I serve.","footnotes":null},{"aya":6,"text":"You have your way, and I have my way.”","footnotes":null}]}