{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"Abundance distracts you.","footnotes":null},{"aya":2,"text":"Until you visit the graveyards.","footnotes":null},{"aya":3,"text":"Indeed, you will know.","footnotes":null},{"aya":4,"text":"Certainly, you will know.","footnotes":null},{"aya":5,"text":"If you knew with knowledge of certainty.","footnotes":null},{"aya":6,"text":"You would see the Inferno.","footnotes":null},{"aya":7,"text":"Then you will see it with the eye of certainty.","footnotes":null},{"aya":8,"text":"Then, on that Day, you will be questioned about the Bliss.","footnotes":null}]}