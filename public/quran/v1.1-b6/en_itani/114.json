{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"Say, “I seek refuge in the Lord of mankind.","footnotes":null},{"aya":2,"text":"The King of mankind.","footnotes":null},{"aya":3,"text":"The God of mankind.","footnotes":null},{"aya":4,"text":"From the evil of the sneaky whisperer.","footnotes":null},{"aya":5,"text":"Who whispers into the hearts of people.","footnotes":null},{"aya":6,"text":"From among jinn and among people.”","footnotes":null}]}