{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"Did We not soothe your heart?","footnotes":null},{"aya":2,"text":"And lift from you your burden.","footnotes":null},{"aya":3,"text":"Which weighed down your back?","footnotes":null},{"aya":4,"text":"And raised for you your reputation?","footnotes":null},{"aya":5,"text":"With hardship comes ease.","footnotes":null},{"aya":6,"text":"With hardship comes ease.","footnotes":null},{"aya":7,"text":"When your work is done, turn to devotion.","footnotes":null},{"aya":8,"text":"And to your Lord turn for everything.","footnotes":null}]}