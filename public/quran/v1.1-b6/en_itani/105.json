{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"Have you not considered how your Lord dealt with the People of the Elephant?","footnotes":null},{"aya":2,"text":"Did He not make their plan go wrong?","footnotes":null},{"aya":3,"text":"He sent against them swarms of birds.","footnotes":null},{"aya":4,"text":"Throwing at them rocks of baked clay.","footnotes":null},{"aya":5,"text":"Leaving them like chewed-up leaves.","footnotes":null}]}