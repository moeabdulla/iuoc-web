{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"By the racers panting.","footnotes":null},{"aya":2,"text":"Igniting sparks.","footnotes":null},{"aya":3,"text":"Raiding at dawn.","footnotes":null},{"aya":4,"text":"Raising clouds of dust.","footnotes":null},{"aya":5,"text":"Storming into the midst.","footnotes":null},{"aya":6,"text":"Indeed, the human being is ungrateful to his Lord.","footnotes":null},{"aya":7,"text":"And he bears witness to that.","footnotes":null},{"aya":8,"text":"And he is fierce in his love of wealth.","footnotes":null},{"aya":9,"text":"Does he not know? When the contents of the graves are scattered around.","footnotes":null},{"aya":10,"text":"And the contents of the hearts are obtained.","footnotes":null},{"aya":11,"text":"Their Lord, on that Day, is fully informed of them.","footnotes":null}]}