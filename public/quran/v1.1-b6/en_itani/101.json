{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"The Shocker.","footnotes":null},{"aya":2,"text":"What is the Shocker?","footnotes":null},{"aya":3,"text":"What will explain to you what the Shocker is?","footnotes":null},{"aya":4,"text":"The Day when the people will be like scattered moths.","footnotes":null},{"aya":5,"text":"And the mountains will be like tufted wool.","footnotes":null},{"aya":6,"text":"As for he whose scales are heavy.","footnotes":null},{"aya":7,"text":"He will be in a pleasant life.","footnotes":null},{"aya":8,"text":"But as for he whose scales are light.","footnotes":null},{"aya":9,"text":"His home is the Abyss.","footnotes":null},{"aya":10,"text":"Do you know what it is?","footnotes":null},{"aya":11,"text":"A Raging Fire.","footnotes":null}]}