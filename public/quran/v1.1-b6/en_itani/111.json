{"source":{"key":"en_itani","name":"Talal Itani","translator":"Talal Itani","version":"July 19, 2013","license":"CC BY-NC-ND 3.0","attribution":"Talal Itani · CC BY-NC-ND 3.0 · tanzil.net","url":"https://blog.clearquran.com/about","sort":3,"footnote_count":0},"verses":[{"aya":1,"text":"Condemned are the hands of Abee Lahab, and he is condemned.","footnotes":null},{"aya":2,"text":"His wealth did not avail him, nor did what he acquired.","footnotes":null},{"aya":3,"text":"He will burn in a Flaming Fire.","footnotes":null},{"aya":4,"text":"And his wife—the firewood carrier.","footnotes":null},{"aya":5,"text":"Around her neck is a rope of thorns.","footnotes":null}]}