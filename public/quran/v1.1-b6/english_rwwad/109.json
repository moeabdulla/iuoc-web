{"source":{"key":"english_rwwad","name":"Rowwad Translation Center","translator":"Rowwad Translation Center","version":"1.0.19","license":"QuranEnc.com / IslamHouse.com redistribution grant","attribution":"Rowwad Translation Center · QuranEnc.com","url":"https://quranenc.com/en/browse/english_rwwad","sort":1,"footnote_count":2215},"verses":[{"aya":1,"text":"Say, “O disbelievers,","footnotes":null},{"aya":2,"text":"I do not worship what you worship,","footnotes":null},{"aya":3,"text":"nor do you worship what I worship.","footnotes":null},{"aya":4,"text":"Never will I worship what you worship,","footnotes":null},{"aya":5,"text":"nor will you ever worship what I worship.","footnotes":null},{"aya":6,"text":"You have your religion and I have my religion.\"","footnotes":null}]}